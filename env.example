# Frontend environment variables
# Skopiuj ten plik do .env.local i uzupełnij wartości

# API URL — w produkcji pełny URL backendu (bez końcowego slasha), np. https://api.helpfli.pl
# Lokalnie możesz zostawić puste — wtedy fetch idzie przez proxy Vite (vite.config.js).
# VITE_API_URL=http://localhost:5000
# VITE_API_URL=https://api.helpfli.pl

# Socket.IO — gdzie klient ma łączyć WebSocket (zwykle ten sam host co API).
# Jeśli puste, używany jest origin strony (np. dev z proxy Vite).
# VITE_SOCKET_URL=https://api.helpfli.pl

# Stripe Publishable Key (pobierz z Stripe Dashboard)
# Test key zaczyna się od pk_test_, production key od pk_live_
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51XXXXYOURKEY

# VAPID Public Key dla Web Push Notifications
# Wygeneruj: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=BDUMMY_PUBLIC

# Włącz/wyłącz Socket.IO (domyślnie: true)
# Ustaw na 'false' aby wyłączyć real-time features
# VITE_ENABLE_SOCKET=true

# Sentry DSN dla error tracking (opcjonalne)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Gateway AI Base URL (domyślnie: http://localhost:7070)
# VITE_GATEWAY_AI_BASE=http://localhost:7070

# Google Analytics 4 (Measurement ID, np. G-XXXXXXXXXX) — pozostaw puste lub
# ustaw "off"/"false" aby całkowicie wyłączyć GA na danym środowisku (DEV).
# Ładowanie idzie przez Consent Mode v2: do zgody = tryb modelowany (brak cookies),
# po zgodzie = pełna analityka. Patrz frontend/src/lib/googleAnalytics.js
# VITE_GA_MEASUREMENT_ID=G-0YJNK66V5J

# Microsoft Clarity — heatmapy + nagrania sesji (darmowe). Project ID z panelu
# clarity.microsoft.com. Skrypt ładuje się DOPIERO po zgodzie na analitykę
# (Clarity nie ma odpowiednika Consent Mode v2). Patrz frontend/src/lib/microsoftClarity.js
# VITE_CLARITY_PROJECT_ID=wx5wr8b3qx

# Operator serwisu (regulamin, stopka, kontakt)
# VITE_COMPANY_LEGAL_NAME=Helpfli
# VITE_COMPANY_EMAIL_CONTACT=helpfli@outlook.com
# VITE_COMPANY_SHOW_REGISTRY=false
# VITE_PUBLIC_SITE_URL=https://helpfli.pl























