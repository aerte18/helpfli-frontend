{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "redirects": [
    { "source": "/uslugi", "destination": "/wykonawcy", "permanent": true },
    { "source": "/uslugi/:service/:city", "destination": "/wykonawcy/:service/:city", "permanent": true },
    { "source": "/orders/:orderId/tab-offers", "destination": "/orders/:orderId?tab=offers", "permanent": false },
    { "source": "/orders/:orderId/tab-my-offer", "destination": "/orders/:orderId?tab=my_offer", "permanent": false },
    { "source": "/orders/:orderId/tab-chat", "destination": "/orders/:orderId?tab=chat", "permanent": false },
    { "source": "/orders/:orderId/tab-details", "destination": "/orders/:orderId?tab=details", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.helpfli.pl/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://api.helpfli.pl/robots.txt" },
    { "source": "/:key([a-zA-Z0-9-]{8,128}).txt", "destination": "https://api.helpfli.pl/:key.txt" },
    { "source": "/api/(.*)", "destination": "https://api.helpfli.pl/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
